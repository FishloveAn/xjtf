[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/scoreboard.gd" id="1_scoreboard"]

[node name="Scoreboard" type="CanvasLayer"]
script = ExtResource("1_scoreboard")

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Root"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -150.0
offset_right = 200.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Root/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Root/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1
text = "段落结算"

[node name="KillsCommon" type="Label" parent="Root/Panel/VBox"]
